{
  "sourceLanguage": "en",
  "strings": {
    "%@ once": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（一次付清）"
          }
        }
      }
    },
    "%@ per month": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月 %@"
          }
        }
      }
    },
    "%@ per year": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每年 %@"
          }
        }
      }
    },
    "%lld minutes": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分鐘"
          }
        }
      }
    },
    "7-day free trial, then %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費試用 7 天，之後%@"
          }
        }
      }
    },
    "A plan gives you one key verse each morning, in order, with a link to read the whole chapter.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀經計畫每天早上依序給你一節重點經文，並可閱讀整章。"
          }
        }
      }
    },
    "Add alarm": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增鬧鐘"
          }
        }
      }
    },
    "Add an alarm to start each day with a verse.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增鬧鐘，每天以一節經文開始。"
          }
        }
      }
    },
    "Add your own sound": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入自己的鈴聲"
          }
        }
      }
    },
    "Advanced editing": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進階編輯"
          }
        }
      }
    },

    "Best streak": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最佳紀錄"
          }
        }
      }
    },
    "Bible Alarm": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Alarm"
          }
        }
      }
    },
    "Bible Alarm Premium": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Alarm 進階版"
          }
        }
      }
    },
    "Bible Alarm has no ads and never will. If it helps you, a tip helps keep it going.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Alarm 沒有廣告，以後也不會有。如果它幫助了你，你的奉獻能讓它繼續下去。"
          }
        }
      }
    },
    "Bible Alarm has no ads and no tracking, and it collects no data.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Alarm 沒有廣告、不追蹤，也不收集任何資料。"
          }
        }
      }
    },
    "Bible Alarm needs permission to ring. Allow alarms in the Settings app.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Alarm 需要權限才能響鈴。請在「設定」中允許鬧鐘。"
          }
        }
      }
    },
    "Bible text": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聖經經文"
          }
        }
      }
    },
    "Bible translations stay free. Premium pays for extra features and supports this ministry. Subscriptions renew automatically until cancelled in your App Store account settings.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聖經譯本永遠免費。進階版提供額外功能，並支持這項事工。訂閱會自動續訂，直到你在 App Store 帳號設定中取消。"
          }
        }
      }
    },
    "Bible version": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聖經譯本"
          }
        }

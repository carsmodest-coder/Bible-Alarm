    },
    "Alarm ID": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鬧鐘編號"
          }
        }
      }
    },
    "Alarms": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鬧鐘"
          }
        }
      }
    },
    "Alarms are turned off": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鬧鐘權限已關閉"
          }
        }
      }
    },
    "Alarms are turned off for Bible Alarm. Allow them in the Settings app.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bible Alarm 的鬧鐘權限已關閉。請在「設定」中允許。"
          }
        }
      }
    },
    "All": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部"
          }
        }
      }
    },
    "All verses": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有經文"
          }
        }
      }
    },
    "Allow alarms": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許鬧鐘"
          }
        }
      }
    },
    "Allow the microphone and speech recognition in the Settings app to read aloud.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中允許麥克風與語音辨識，才能朗讀作答。"
          }
        }
      }
    },
    "Allow the microphone in the Settings app to record.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中允許使用麥克風才能錄音。"
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已允許"
          }
        }
      }
    },
    "Amen": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阿們"
          }
        }
      }
    },
    "An alarm that waits for you": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等你讀完的鬧鐘"
          }
        }
